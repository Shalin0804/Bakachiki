# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
# Public URL of the API (used for absolute image URLs in sitemap etc.)
SERVER_URL=http://localhost:5000

# --- MySQL 8 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bakachiki
DB_USER=root
DB_PASSWORD=

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Seeded admin account (used by `npm run seed`) ---
ADMIN_EMAIL=admin@bakachiki.in
ADMIN_PASSWORD=ChangeMe@123

# --- Image storage: "local" (server/uploads) or "cloudinary" ---
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (leave empty to disable online payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMTP for password reset mails (empty = reset links are logged to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BAKACHIKI <no-reply@bakachiki.in>"
